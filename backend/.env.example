# ==============================================================================
# SkillKart Environment Configuration Template
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/skillkart

# Authentication
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Notifications (SMTP / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=SkillKart <no-reply@skillkart.com>

# ==============================================================================
# FILE STORAGE CONFIGURATION
# STORAGE_PROVIDER can be 'local' (for local development) or 'r2' (Cloudflare R2)
# ==============================================================================
STORAGE_PROVIDER=local

# Cloudflare R2 Settings (Fill when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
